not(
(always(
A & B & C & D & E    | 
    B & C & D & E & F| 
A &     C & D & E & F| 
A & B &     D & E & F| 
A & B & C &     E & F|
A & B & C & D &     F
) 
&
always(sometime (A))&
always(sometime (B))&
always(sometime (C))&
always(sometime (D))&
always(sometime (E))&
always(sometime (F))
) ->
sometime(A & next (B &  next (C & next (D & next (E & next F)))))
)
